{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vp test run --passWithNoTests",
    "test:watch": "vp test",
    "lint": "vp lint",
    "check": "vp check",
    "fmt": "vp fmt",
    "cap:build": "APP_BUILD=capacitor nuxt build && node scripts/cap-extract-spa.mjs",
    "build:android": "APP_BUILD=capacitor nuxt build && node scripts/cap-extract-spa.mjs && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "prepare": "vp config"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@iconify-json/lucide": "^1.2.138",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/ui": "^4.11.2",
    "@pinia/nuxt": "^1.0.2",
    "capacitor-sunmi-printer": "file:./plugins/capacitor-sunmi-printer",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.12.7",
    "graphql-ws": "^6.3.0",
    "nuxt": "4.5.2",
    "oidc-client-ts": "^3.5.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@types/node": "^24.13.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite-plus": "1.0.0",
    "vue-tsc": "^3.3.12"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "^0.28.2",
    "@esbuild/linux-x64": "^0.28.2",
    "@oxc-minify/binding-linux-arm64-gnu": "^0.151.0",
    "@oxc-minify/binding-linux-x64-gnu": "^0.151.0",
    "@oxc-parser/binding-linux-arm64-gnu": "^0.151.0",
    "@oxc-parser/binding-linux-x64-gnu": "^0.151.0",
    "@oxc-transform/binding-linux-arm64-gnu": "^0.151.0",
    "@oxc-transform/binding-linux-x64-gnu": "^0.151.0",
    "@rollup/rollup-linux-arm64-gnu": "^4.63.6",
    "@rollup/rollup-linux-x64-gnu": "^4.63.6",
    "@tailwindcss/oxide-linux-arm64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "lightningcss-linux-arm64-gnu": "^1.33.0",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.0",
      "onFail": "download"
    }
  }
}
