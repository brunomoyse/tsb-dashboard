    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@iconify-json/lucide": "^1.2.147",
    "@nuxt/icon": "^2.6.0",
    "@nuxt/ui": "^4.12.0",
    "@pinia/nuxt": "^1.0.3",
    "capacitor-sunmi-printer": "file:./plugins/capacitor-sunmi-printer",
    "graphql": "^17.0.2",
    "graphql-tag": "^2.12.7",
    "graphql-ws": "^6.4.1",
    "nuxt": "4.6.2",
