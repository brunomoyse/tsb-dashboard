  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/i18n": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "ofetch": "^1.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
