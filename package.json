    "build:android": "APP_BUILD=capacitor nuxt build && node scripts/cap-extract-spa.mjs && cap sync android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "prepare": "vp config"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
